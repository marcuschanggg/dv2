    {
      "data": {
        "url": "Regional_Development_Commissions_Regions_DPIRD_020_WA_GDA2020_Public.json",
        "format": {
          "type": "topojson",
          "feature": "Regional_Development_Commissions_Regions_DPIRD_020_WA_GDA2020_Public"
        }
      },
      "transform": [
        {
          "lookup": "properties.region",
          "from": {
            "data": {
              "url": "region_richness_data.csv"
            },
            "key": "region",
            "fields": [
              "richness",
              "n_records",
              "std_richness"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FBFAF5",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "std_richness",
          "type": "quantitative",
          "scale": {
            "scheme": "yellowgreenblue"
          },
          "legend": {
            "title": "Species per 1,000 records (standardised)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 320,
            "gradientThickness": 12,
            "offset": 16
          }
        },
        "tooltip": [
          {
            "field": "properties.region",
            "title": "Region"
          },
          {
            "field": "std_richness",
            "title": "Species per 1,000 records"
          },
          {
            "field": "richness",
            "title": "Species recorded (raw)"
          },
          {
            "field": "n_records",
