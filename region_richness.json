{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Species Richness Across Regions",
  "width": 820,
  "height": 500,
  "projection": {
    "type": "mercator"
  },
  "config": {
    "view": {
      "stroke": null
