{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Seasonal activity profiles: six species to watch (2025)",
  "width": 580,
  "height": 46,
  "data": {
    "url": "chart_ridgeline_data.csv",
    "format": {
      "type": "csv",
      "parse": {
        "month_num": "number",
        "n": "number"
      }
    }
  },
  "mark": {
    "type": "area",
    "interpolate": "monotone",
    "line": {
      "strokeWidth": 1
    },
    "opacity": 0.85
  },
  "encoding": {
    "x": {
      "field": "month_num",
      "type": "ordinal",
      "title": null,
      "sort": "ascending",
      "axis": {
        "labelExpr": "['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][datum.value]",
        "labelAngle": 0,
        "labelAlign": "center",
        "labelOverlap": false,
        "labelPadding": 4
      }
    },
    "y": {
      "field": "n",
      "type": "quantitative",
      "title": null,
      "axis": null
    },
    "color": {
      "field": "common",
      "type": "nominal",
      "scale": {
        "domain": [
          "Western Rosella",
          "Red-capped Parrot",
          "Splendid Fairywren",
          "Rainbow Bee-eater",
          "Tawny Frogmouth",
          "Regent Parrot"
        ],
        "range": [
          "#1B9E77",
          "#D95F02",
          "#7570B3",
          "#E7298A",
          "#66A61E",
          "#CC8F00"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "title": null,
        "columns": 3,
        "labelFontSize": 12,
        "symbolSize": 160,
        "columnPadding": 22,
        "rowPadding": 6,
        "offset": 14,
        "symbolType": "square"
      }
    },
    "row": {
      "field": "common",
      "type": "nominal",
      "title": null,
      "header": {
        "labels": false,
        "title": null
      },
      "sort": {
        "field": "n",
        "op": "sum",
        "order": "descending"
      }
    }
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 2
    }
  },
  "padding": {
    "left": 125,
    "right": 125,
    "top": 6,
    "bottom": 6
  }
}
