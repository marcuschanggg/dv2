{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "title": {
  "text": "Where each of six WA species was recorded (2025)",
  "subtitle": {
   "expr": "species_pick + ': ' + {'Western Rosella': 'none of its records are north of 30\u00b0S', 'Red-capped Parrot': 'none of its records are north of 30\u00b0S', 'Splendid Fairywren': '3% of its records are north of 30\u00b0S', 'Rainbow Bee-eater': '31% of its records are north of 30\u00b0S', 'Tawny Frogmouth': '12% of its records are north of 30\u00b0S', 'Regent Parrot': '1% of its records are north of 30\u00b0S'}[species_pick]"
  },
  "subtitleFontSize": 13,
  "subtitlePadding": 6
 },
 "width": 760,
 "height": 520,
 "padding": {
  "left": 35,
  "right": 35,
  "top": 5,
  "bottom": 5
 },
 "projection": {
  "type": "conicEqualArea",
  "parallels": [
   -20,
   -34
  ],
  "rotate": [
   -122,
   0
  ]
 },
 "params": [
  {
   "name": "species_pick",
   "value": "Western Rosella",
   "bind": {
    "input": "select",
    "options": [
     "Western Rosella",
     "Red-capped Parrot",
     "Splendid Fairywren",
     "Rainbow Bee-eater",
     "Tawny Frogmouth",
     "Regent Parrot"
    ],
    "name": "Choose a bird: "
   }
  }
 ],
 "layer": [
  {
   "data": {
    "url": "wa_topo.json",
    "format": {
     "type": "topojson",
     "feature": "wa"
    }
   },
   "mark": {
    "type": "geoshape",
    "fill": "#EBE6D4",
    "stroke": "#8A3B24",
    "strokeWidth": 0.5
   }
  },
  {
   "data": {
    "url": "species_distribution_data.csv",
    "format": {
     "type": "csv",
     "parse": {
      "lat": "number",
      "lon": "number"
     }
    }
   },
   "transform": [
    {
     "filter": "datum.species === species_pick"
    }
   ],
   "mark": {
    "type": "circle",
    "size": 40,
    "opacity": 0.6
   },
   "encoding": {
    "longitude": {
     "field": "lon",
     "type": "quantitative"
    },
    "latitude": {
     "field": "lat",
     "type": "quantitative"
    },
    "color": {
     "field": "species",
     "type": "nominal",
     "scale": {
      "domain": [
       "Western Rosella",
       "Red-capped Parrot",
       "Splendid Fairywren",
       "Rainbow Bee-eater",
       "Tawny Frogmouth",
       "Regent Parrot"
      ],
      "range": [
       "#1B9E77",
       "#D95F02",
       "#7570B3",
       "#E7298A",
       "#66A61E",
       "#CC8F00"
      ]
     },
     "legend": null
    },
    "tooltip": [
     {
      "field": "species",
      "type": "nominal",
      "title": "Species"
     }
    ]
   }
  },
  {
