{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Where six WA species were recorded (2025)",
  "data": {
    "url": "species_distribution_data.csv"
  },
  "facet": {
    "field": "species",
    "type": "nominal",
    "title": null,
    "sort": [
      "Western Rosella",
      "Red-capped Parrot",
      "Splendid Fairywren",
      "Rainbow Bee-eater",
      "Tawny Frogmouth",
      "Regent Parrot"
    ],
    "header": {
      "labelFontSize": 12,
      "labelFontWeight": "bold",
      "labelPadding": 4,
      "labelExpr": "datum.value + '\\n' + {'Western Rosella': 'none north of 30\\u00b0S', 'Red-capped Parrot': 'none north of 30\\u00b0S', 'Splendid Fairywren': '3% north of 30\\u00b0S', 'Rainbow Bee-eater': '31% north of 30\\u00b0S', 'Tawny Frogmouth': '12% north of 30\\u00b0S', 'Regent Parrot': '1% north of 30\\u00b0S'}[datum.value]",
      "labelLineHeight": 15
    }
  },
  "columns": 3,
  "spec": {
    "width": 230,
    "height": 165,
    "projection": {
      "type": "mercator"
    },
    "layer": [
      {
        "data": {
          "url": "wa_topo.json",
          "format": {
            "type": "topojson",
            "feature": "wa"
          }
        },
        "mark": {
          "type": "geoshape",
          "fill": "#EBE6D4",
          "stroke": "#8A3B24",
          "strokeWidth": 0.5
        }
      },
      {
        "mark": {
          "type": "circle",
          "size": 18,
          "opacity": 0.75
        },
        "encoding": {
          "longitude": {
            "field": "lon",
            "type": "quantitative"
          },
          "latitude": {
            "field": "lat",
            "type": "quantitative"
          },
          "color": {
            "field": "species",
            "type": "nominal",
            "scale": {
              "scheme": "dark2"
            },
            "legend": null
          }
        }
      },
      {
        "data": {
          "values": [
            {
              "lat": -30,
              "lon": 113.2,
              "lat2": -30,
              "lon2": 129.2
            }
          ]
        },
        "mark": {
          "type": "rule",
          "color": "#6B6A5C",
          "strokeWidth": 1,
          "strokeDash": [
            3,
            3
          ]
        },
        "encoding": {
          "longitude": {
            "field": "lon",
            "type": "quantitative"
          },
          "latitude": {
            "field": "lat",
            "type": "quantitative"
          },
          "longitude2": {
            "field": "lon2"
          },
          "latitude2": {
            "field": "lat2"
          }
        }
      },
      {
        "data": {
          "values": [
            {
              "lat": -30,
              "lon": 129.4,
              "t": "30\u00b0S"
            }
          ]
        },
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "dx": 2,
          "fontSize": 9,
          "color": "#6B6A5C"
        },
        "encoding": {
          "longitude": {
            "field": "lon",
            "type": "quantitative"
          },
          "latitude": {
            "field": "lat",
            "type": "quantitative"
          },
          "text": {
            "field": "t",
            "type": "nominal"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    }
  }
}