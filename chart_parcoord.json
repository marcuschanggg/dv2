{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Bird populations in WA: 2015 vs. 2025 (top 18 species)",
    "subtitle": "Magpie-lark fell from 4th to 17th: its count halved (\u221251%)",
    "subtitleColor": "#0A6B1D",
    "subtitleFontSize": 13,
    "subtitleFontWeight": 600,
    "subtitlePadding": 6
  },
  "width": 300,
  "height": 600,
  "padding": {
    "left": 130,
    "right": 130
  },
  "data": {
    "url": "chart_parcoord_data.csv",
    "format": {
      "type": "csv",
      "parse": {
        "axis_order": "number",
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.axis_order == 0 || datum.axis_order == 1"
    },
    {
      "calculate": "datum.axis_order == 0 ? datum.raw_count_2015 : datum.raw_count_2025",
      "as": "population"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "population",
          "order": "descending"
        }
      ],
      "groupby": [
        "axis_order"
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "opacity": 0.75,
        "strokeWidth": 4.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "axis_order",
          "type": "ordinal",
          "title": null,
          "sort": "ascending",
          "axis": {
            "labelExpr": "['2015', '2025'][datum.value]",
            "labelAngle": 0,
            "labelFontSize": 15,
            "labelPadding": 15,
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "title": null,
          "axis": null,
          "scale": {
            "reverse": true
          }
        },
        "color": {
          "field": "common",
          "type": "nominal",
          "scale": {
            "domain": [
              "Australian Raven",
              "Willie Wagtail",
              "Australian Ringneck",
              "Singing Honeyeater",
              "Red Wattlebird",
              "Australian Magpie",
              "Magpie-lark",
              "Brown Honeyeater",
              "Galah",
              "Western Gerygone",
              "Silvereye",
              "Striated Pardalote",
              "Grey Fantail",
              "Weebill",
              "Black-faced Cuckoo-shrike",
              "New Holland Honeyeater",
              "Welcome Swallow",
              "Pacific Black Duck"
            ],
            "range": [
              "#C43F3E",
              "#12B382",
              "#8C54C3",
              "#BE9014",
              "#0581A3",
              "#EB648A",
              "#118D29",
              "#9085FB",
              "#A56202",
              "#09ACBA",
              "#B5418B",
              "#81A904",
              "#426DD7",
              "#EA6F2F",
              "#12867C",
              "#CB6FD1",
              "#7F770D",
              "#069FF9"
            ]
          },
          "legend": null
        },
        "detail": {
          "field": "common"
        },
        "tooltip": [
          {
            "field": "common",
            "title": "Species"
          },
          {
            "field": "population",
            "title": "Count",
            "format": ","
          },
          {
            "field": "change_pct",
            "title": "Change (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "axis_order",
          "type": "ordinal",
          "sort": "ascending"
        },
        "y": {
          "field": "rank",
          "type": "quantitative"
        },
        "color": {
          "field": "common",
          "type": "nominal",
          "scale": {
            "domain": [
              "Australian Raven",
